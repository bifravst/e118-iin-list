{
  "name": "e118-iin-list",
  "version": "0.0.0-development",
  "description": "List of issuer identifier numbers for the international telecommunication charge card (ITU-T E.118)",
  "type": "module",
  "bin": "dist/cli.js",
  "exports": {
    "import": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts"
  },
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test src/*.spec.ts",
    "convert": "node --experimental-transform-types --no-warnings src/convert.ts",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "npx tsc --noEmit false -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/e118-iin-list.git"
  },
  "keywords": [
    "nrf-asset-tracker",
    "e118",
    "itu-t",
    "iin",
    "iccid",
    "issuer"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/bifravst/e118-iin-list/issues"
  },
  "homepage": "https://github.com/bifravst/e118-iin-list#readme",
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.2",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "check-node-version": "4.2.1",
    "csv-parser": "3.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config"
}
